{
  "name": "launchpad",
  "version": "0.1.0",
  "private": true,
  "description": "Local pipeline turning public-domain NASA footage into short kids' science videos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "tsx src/cli/doctor.ts",
    "nasa:search": "tsx src/cli/nasa-search.ts",
    "nasa:fetch": "tsx src/cli/nasa-fetch.ts",
    "video:new": "tsx src/cli/video.ts new",
    "video:status": "tsx src/cli/video.ts status",
    "video:show": "tsx src/cli/video.ts show",
    "run:start": "tsx src/cli/video.ts run-start",
    "run:finish": "tsx src/cli/video.ts run-finish",
    "script:validate": "tsx src/cli/script-validate.ts",
    "agent:validate": "tsx src/cli/agent-validate.ts",
    "media:tts": "tsx src/cli/media-tts.ts",
    "media:voices": "tsx src/cli/voice-samples.ts",
    "media:align": "tsx src/cli/media-align.ts",
    "media:captions": "tsx src/cli/media-captions.ts",
    "media:render": "tsx src/cli/media-render.ts",
    "qa:check": "tsx src/cli/qa.ts check",
    "qa:frames": "tsx src/cli/qa.ts frames",
    "media:test-clip": "tsx src/cli/media-test-clip.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "kokoro-js": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
